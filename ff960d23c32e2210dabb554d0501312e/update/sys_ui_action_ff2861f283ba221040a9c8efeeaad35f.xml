        <name>Reschedule Appointment</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function executeAction(current) {
    // Add 1 day to current appointment date
    if (!current.u_appointment_date) {
        gs.addErrorMessage("Appointment date is not set.");
        return;
    }

    var newDate = new GlideDateTime(current.u_appointment_date);
    newDate.addDaysUTC(1);
    current.setValue('appointment_date', newDate);
    current.update();

    // Notify patient using event
    gs.eventQueue('appointment.rescheduled', current, gs.getUserID(), current.u_patient_id);

    gs.addInfoMessage("Appointment rescheduled to: " + newDate.getDisplayValue());
})(current);
]]></script>
