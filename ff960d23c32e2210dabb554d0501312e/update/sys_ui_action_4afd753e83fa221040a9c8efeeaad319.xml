        <name>Cancel Appointment</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function executeAction(current) {
    // Check if already cancelled
    if (current.u_status == 'Cancelled') {
        gs.addInfoMessage("Appointment is already cancelled.");
        return;
    }

    // Set status to Cancelled
    current.u_status = 'Cancelled';
    current.update();

    // Fire notification event to doctor and patient
    gs.eventQueue('appointment.cancelled', current, current.u_doctor_id, current.u_patient_id);

    // Show confirmation message on form
    gs.addInfoMessage("Appointment has been cancelled. Notifications sent.");
})(current);
]]></script>
