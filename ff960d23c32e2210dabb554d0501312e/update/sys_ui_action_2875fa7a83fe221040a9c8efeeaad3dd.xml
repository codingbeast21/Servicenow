        <name>Generate Bill</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function executeRule(current, previous /* null when async */) {
  // Create a new billing record
  var newBilling = new GlideRecord('u_billing');
  newBilling.initialize();
  newBilling.patient_id = current.u_patient_id;
  newBilling.appointment_id = current.u_appointment_id;
  newBilling.total_amount = current.u_total_amount;
//   newBilling.status = 'pending';
  newBilling.insert();

  // Notify billing department (can be via email, event, etc.)
  gs.eventQueue('billing.generated', newBilling, current.u_patient_id, current.u_appointment_id);
  gs.addInfoMessage("new billing record is created");

})(current, previous);
]]></script>
