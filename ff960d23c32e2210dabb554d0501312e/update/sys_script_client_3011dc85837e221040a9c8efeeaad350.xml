        <name>CheckEndDate</name>
        <order/>
        <script><![CDATA[function onSubmit() {
  var startStr = g_form.getValue('u_start_date');
  var endStr = g_form.getValue('u_end_date');
 
  if (!startStr || !endStr) {
    return true; // allow submit if either field is empty
  }
 
  var start = new Date(startStr);
  var end = new Date(endStr);
 
  if (end < start) {
    g_form.showFieldMsg('end_date', 'End date must be after start date', 'error');
    return false; // prevent form submit
  }
 
  return true;
}
 
 ]]></script>
