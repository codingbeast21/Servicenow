        <script><![CDATA[function onSubmit() {
    
    var startDate = g_form.getValue('v_start_date');
    var endDate = g_form.getValue('v_end_date');
    if (new Date(startDate) >= new Date(endDate)) {
        alert("End date must be after the start date.");
        return false;
    }

    var dosageStr = g_form.getValue('v_dosage').trim();
    var dosageNum = parseFloat(dosageStr);
    if (dosageStr === '' || isNaN(dosageNum)) {
        alert("Please enter a valid numeric dosage.");
        return false;
    }


    if (dosageNum <= 0 || dosageNum > 1000) {
        alert("Dosage must be between 1 and 1000.");
        return false;
    }

    return true;
 }
]]></script>
