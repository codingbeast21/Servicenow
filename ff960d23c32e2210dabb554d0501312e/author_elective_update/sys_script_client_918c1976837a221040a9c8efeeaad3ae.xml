        <messages/>
        <name>RescheduleAppointmentClient</name>
        <order/>
        <script><![CDATA[function onLoad() {
    var appointmentId = g_form.getUniqueValue(); // get current record ID
    var newDate = g_form.getValue('appointment_date'); // get current appointment_date

    // OPTIONAL: Validate date format or restrict past dates
    if (!newDate) {
        g_form.showFieldMsg('appointment_date', 'Please enter a new appointment date.', 'error');
        return;
    }

    var selectedDate = new Date(newDate);
    var now = new Date();

    if (selectedDate < now) {
        g_form.showFieldMsg('appointment_date', 'Cannot reschedule to a past date.', 'error');
        return;
    }

    var ga = new GlideAjax('RescheduleUtils');
    ga.addParam('sysparm_name', 'rescheduleAppointment');
    ga.addParam('sysparm_appointment_id', appointmentId);
    ga.addParam('sysparm_new_date', newDate);

    ga.getXMLAnswer(function(response) {
        try {
            var result = JSON.parse(response);
            if (result.success) {
                g_form.showFieldMsg('appointment_date', result.message, 'info');
                g_form.save(); // Save form with new date
            } else {
                g_form.showFieldMsg('appointment_date', result.message, 'error');
            }
        } catch (e) {
            g_form.showFieldMsg('appointment_date', 'An unexpected error occurred.', 'error');
        }
    });


   
}]]></script>
